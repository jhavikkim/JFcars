# Host port used by Docker Compose. Nginx proxies to this loopback port.
JFCARS_PORT=3010

# Public origin used in email verification links.
JFCARS_PUBLIC_URL=https://jfcars.4rbl.com

# Gmail/Google Workspace hosts the mailboxes. Resend sends transactional
# website email after justandfun.com has been verified in Resend.
RESEND_API_KEY=re_replace_with_your_key
JFCARS_FROM_EMAIL=JFcars <noreply@justandfun.com>
JFCARS_REPLY_TO_EMAIL=contact@justandfun.com
JFCARS_CONTACT_EMAIL=contact@justandfun.com
JFCARS_SALES_EMAIL=sales@justandfun.com
JFCARS_ADMIN_EMAIL=jfcars@justandfun.com
JFCARS_INFO_EMAIL=infos@justandfun.com
